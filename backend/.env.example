# WordFlow backend — local dev environment.
# Copy this file to .env and fill in the real secrets. .env is gitignored.

# ---- Postgres (used by docker-compose) -------------------------
POSTGRES_USER=wordflow
POSTGRES_PASSWORD=wordflow
POSTGRES_DB=wordflow

# ---- App -------------------------------------------------------
PORT=8080
ENV=development

# ---- Clerk (Phase 5) -------------------------------------------
# Backend API key from the Clerk dashboard → API Keys → Secret keys
CLERK_SECRET_KEY=
# Your Clerk instance's authorized party (azp claim). Found on the
# Clerk dashboard → API Keys → Show JWT template, or in the JWT payload.
# CRITICAL: Clerk verification silently succeeds on wrong azp if this
# is empty.
CLERK_AUTHORIZED_PARTY=

# ---- OpenRouter (Phase 8 AI proxy) -----------------------------
# Same key currently used by the android app's BuildConfig.
# Will be removed from the APK in Phase 15.
OPENROUTER_API_KEY=
