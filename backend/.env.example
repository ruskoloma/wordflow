# WordFlow backend — environment variables.
#
# For LOCAL dev: secrets live in /tmp/env.local (one level up from
# backend/) and docker-compose.yml loads them via env_file. This file
# is just a checked-in reference of what the code expects.
#
# For PRODUCTION on Railway: set each of these in the service's
# Variables tab. Railway injects $PORT automatically — you don't need
# to set it yourself.

# ---- Postgres --------------------------------------------------
# Used by docker-compose for local dev.
POSTGRES_USER=wordflow
POSTGRES_PASSWORD=wordflow
POSTGRES_DB=wordflow

# REQUIRED everywhere the server runs. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# DigitalOcean managed PG needs sslmode=require; local compose
# uses sslmode=disable.
# DATABASE_URL=postgres://wordflow:wordflow@postgres:5432/wordflow?sslmode=disable

# ---- App -------------------------------------------------------
PORT=8080
ENV=development

# ---- Clerk -----------------------------------------------------
# Backend API key (sk_test_... or sk_live_...) from the Clerk
# dashboard → API Keys → Secret keys.
CLERK_SECRET_KEY=

# Publishable key (pk_test_... or pk_live_...). Needed for the
# passwordless email-code sign-in flow — the backend calls Clerk's
# Frontend API with this key.
CLERK_PUBLISHABLE_KEY=

# Clerk JWT 'azp' claim validation. In dev we leave this empty and
# the middleware skips the check with a warning. For production
# you'd set this to the frontend origin that mints Clerk tokens —
# for a mobile-only app that doesn't really apply, so empty is OK.
CLERK_AUTHORIZED_PARTY=

# ---- OpenRouter (AI proxy) -------------------------------------
# Used by /v1/ai/translate and /v1/ai/generate-collection.
OPENROUTER_API_KEY=
# Default model is google/gemini-2.0-flash-001 — override to swap
# providers without touching code.
OPENROUTER_MODEL=google/gemini-2.0-flash-001
